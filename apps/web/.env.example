# Database connection strings (PostgreSQL / Supabase)
# SUPER IMPORTANT: For Vercel deployments, use the Supabase Connection Pooler (port 6543) and set pgbouncer=true to prevent connection limit crashes.
DATABASE_URL="postgres://postgres.xxx:password@aws-0-xx.pooler.supabase.com:6543/postgres?pgbouncer=true"

# You also MUST provide the DIRECT_URL (port 5432) for Prisma migrations and schema introspections.
DIRECT_URL="postgres://postgres.xxx:password@aws-0-xx.pooler.supabase.com:5432/postgres"
# QuickLabz App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BRAND_NAME="QuickLabz"
NEXT_PUBLIC_SUPPORT_PHONE="7018623940"
NEXT_PUBLIC_SUPPORT_EMAIL="quicklabzofficial@gmail.com"
NEXT_PUBLIC_WHATSAPP_NUMBER="917018623940"

# JWT Secret
JWT_SECRET="your_secure_jwt_secret_key"
NODE_ENV="production"
